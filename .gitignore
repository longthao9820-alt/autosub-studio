*.egg-info/

# User data, workspace & configs
# Root-only: Git ignore is case-insensitive on Windows; a recursive Data/ rule
# would accidentally hide the source package src/autosub_studio/data/.
/Data/
/db/
*.db
*.sqlite
*.sqlite3

# Secrets & credentials
secrets.dat
**/secrets.dat
*.dat
.env
.env.*
*.key
*.pem
*.secret

# Large binaries & vendor assets (tải ngoài theo README, không đưa vào Git)
assets/cuda/
assets/ffmpeg/
assets/download/
assets/models/
/assets/piper/
*.dll
*.exe
*.bin

